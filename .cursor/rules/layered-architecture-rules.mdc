### 2. 錯誤處理策略
```python
# 核心算法層：詳盡的錯誤分析
def convert_dicom_core(dicom_path: Path) -> ConversionResult:
    """
    核心轉換算法
    前置條件：dicom_path 必須存在且為有效 DICOM 檔案
    後置條件：成功時返回 NIfTI 資料，失敗時返回詳細錯誤資訊
    """
    if not dicom_path.exists():
        return ConversionResult.error("DICOM_FILE_NOT_FOUND", "檔案不存在")
    
    # 詳盡的算法實現...

# 業務邏輯層：簡潔的錯誤轉換
async def convert_dicom_service(file: UploadFile) -> ConversionResponse:
    """業務服務層 - 簡潔的錯誤處理"""
    temp_path = await save_temp_file(file)
    result = convert_dicom_core(temp_path)
    
    if not result.success:
        raise HTTPException(500, result.error_message)
    
    return ConversionResponse.from_result(result)
```

