    error_message: str
    processing_time: float

# 核心算法層 → 業務邏輯層
def process_medical_image(image_data: np.ndarray) -> ProcessingResult:
    """核心算法層接口 - 遵循 Linus 簡潔原則"""
    pass

# 業務邏輯層 → API 層
@router.post("/process")
async def process_endpoint(file: UploadFile) -> ProcessingResponse:
