            is_valid=len(violations) == 0,
            issues=violations
        )
    
    def validate_separation_of_concerns(self, proposal: SolutionProposal) -> ValidationResult:
        """驗證關注點分離"""
        ui_logic_mixed = self._check_ui_logic_separation(proposal)
        business_logic_mixed = self._check_business_logic_separation(proposal)
        
        issues = []
        if ui_logic_mixed:
            issues.append("UI 邏輯與業務邏輯混合")
        if business_logic_mixed:
            issues.append("業務邏輯分離不當")
        
        return ValidationResult(
            is_valid=len(issues) == 0,
            issues=issues
        )
