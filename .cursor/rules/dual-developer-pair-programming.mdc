# ✅ 安全性檢查
class SecurityValidator:
    """安全性驗證器"""
    
    def validate_security_practices(self, proposal: SolutionProposal) -> ValidationResult:
        """驗證安全實踐"""
        security_issues = []
        
        # 輸入驗證檢查
        if not self._has_input_validation(proposal):
            security_issues.append("缺少輸入驗證")
        
        # 錯誤處理檢查
        if not self._has_proper_error_handling(proposal):
            security_issues.append("錯誤處理不當，可能洩露敏感資訊")
        
        # 權限檢查
        if not self._has_authorization_checks(proposal):
            security_issues.append("缺少權限驗證")
        
        return ValidationResult(
            is_valid=len(security_issues) == 0,
            issues=security_issues
        )
    
    def validate_best_practices(self, proposal: SolutionProposal) -> ValidationResult:
        """驗證最佳實踐"""
        best_practice_issues = []
        
        # 非同步操作檢查
        if not self._uses_async_properly(proposal):
            best_practice_issues.append("未正確使用非同步操作")
        
        # 錯誤處理檢查
        if not self._has_comprehensive_error_handling(proposal):
            best_practice_issues.append("錯誤處理不全面")
        
        # 效能考量檢查
        if not self._considers_performance(proposal):
            best_practice_issues.append("未考慮效能影響")
        
        return ValidationResult(
            is_valid=len(best_practice_issues) == 0,
            issues=best_practice_issues
        )
