# ✅ 上下文更新策略
class ContextUpdateStrategy:
    """上下文更新策略"""
    
    def update_context_incrementally(self, 
                                   existing_context: Dict, 
                                   changes: List[ProjectChange]) -> Dict:
        """增量更新上下文"""
        updated_context = existing_context.copy()
        
        for change in changes:
            if change.type == "new_feature":
                self._add_feature_to_context(updated_context, change.feature)
            elif change.type == "modified_component":
                self._update_component_in_context(updated_context, change.component)
            elif change.type == "removed_feature":
                self._remove_feature_from_context(updated_context, change.feature)
        
        # 更新時間戳和版本
        updated_context["metadata"]["last_updated"] = datetime.now().isoformat()
        updated_context["metadata"]["version"] = self._increment_version(
            existing_context["metadata"]["version"]
        )
        
        return updated_context
