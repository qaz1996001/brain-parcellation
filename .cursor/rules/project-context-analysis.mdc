# ✅ 醫學影像功能分析器
class MedicalImagingFeatureAnalyzer:
    """醫學影像功能分析器"""
    
    def analyze_dicom_processing_features(self, project_analysis: ProjectAnalysis) -> List[DicomFeature]:
        """分析 DICOM 處理功能"""
        dicom_features = []
        
        # DICOM 到 NIfTI 轉換
        conversion_feature = self._analyze_dicom_conversion(project_analysis)
        if conversion_feature:
            dicom_features.append(conversion_feature)
        
        # 醫學影像管線
        pipeline_features = self._analyze_medical_pipelines(project_analysis)
        dicom_features.extend(pipeline_features)
        
        # 影像處理工具
        processing_features = self._analyze_image_processing(project_analysis)
        dicom_features.extend(processing_features)
        
        return dicom_features
    
    def map_medical_workflows(self, features: List[DicomFeature]) -> MedicalWorkflowMap:
        """映射醫學工作流程"""
        workflow_map = MedicalWorkflowMap()
        
        for feature in features:
            workflow = MedicalWorkflow()
            
            # 醫學資料輸入流程
            workflow.data_input = self._map_medical_data_input(feature)
            
            # 處理管線流程
            workflow.processing_pipeline = self._map_processing_steps(feature)
            
            # 結果輸出流程
            workflow.result_output = self._map_result_output(feature)
            
            # 品質控制檢查
            workflow.quality_checks = self._map_quality_controls(feature)
            
            workflow_map.add_workflow(feature.name, workflow)
        
        return workflow_map
