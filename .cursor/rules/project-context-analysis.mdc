# ✅ 功能映射器
class FeatureMapper:
    """功能映射器"""
    
    def identify_core_features(self, project_analysis: ProjectAnalysis) -> List[CoreFeature]:
        """識別核心功能"""
        features = []
        
        # 從 API 端點識別功能
        api_features = self._extract_features_from_apis(project_analysis.api_endpoints)
        features.extend(api_features)
        
        # 從管線識別功能
        pipeline_features = self._extract_features_from_pipelines(project_analysis.pipelines)
        features.extend(pipeline_features)
        
        # 從服務類別識別功能
        service_features = self._extract_features_from_services(project_analysis.services)
        features.extend(service_features)
        
        return features
    
    def map_feature_workflows(self, feature: CoreFeature) -> FeatureWorkflow:
        """映射功能工作流程"""
        workflow = FeatureWorkflow()
        
        # 識別入口點
        workflow.entry_points = self._identify_entry_points(feature)
        
        # 映射用戶工作流程
        workflow.user_journey = self._map_user_journey(feature)
        
        # 識別狀態管理
        workflow.state_management = self._analyze_feature_state(feature)
        
        # 識別邊緣案例
        workflow.edge_cases = self._identify_edge_cases(feature)
        
        # 識別錯誤狀態
        workflow.error_states = self._identify_error_states(feature)
        
        # 識別載入狀態
        workflow.loading_states = self._identify_loading_states(feature)
        
        return workflow
