# ✅ Python 程式碼分析器
class PythonCodeAnalyzer:
    """Python 程式碼分析器"""
    
    def analyze_python_file(self, file_path: Path) -> PythonFileAnalysis:
        """分析 Python 檔案"""
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        tree = ast.parse(content)
        
        analysis = PythonFileAnalysis()
        analysis.imports = self._extract_imports(tree)
        analysis.classes = self._extract_classes(tree)
        analysis.functions = self._extract_functions(tree)
        analysis.constants = self._extract_constants(tree)
        analysis.dependencies = self._analyze_dependencies(tree)
        analysis.api_endpoints = self._extract_api_endpoints(tree)
        analysis.error_handling = self._analyze_error_handling(tree)
        
        return analysis
    
    def extract_component_responsibilities(self, analysis: PythonFileAnalysis) -> List[str]:
        """提取組件職責"""
        responsibilities = []
        
        # 從類別名稱推斷職責
        for class_info in analysis.classes:
            if "Service" in class_info.name:
                responsibilities.append(f"業務邏輯服務: {class_info.name}")
            elif "Model" in class_info.name:
                responsibilities.append(f"資料模型: {class_info.name}")
            elif "Router" in class_info.name:
                responsibilities.append(f"API 路由: {class_info.name}")
        
        # 從函數名稱推斷職責
        for func_info in analysis.functions:
            if func_info.name.startswith("process_"):
                responsibilities.append(f"資料處理: {func_info.name}")
            elif func_info.name.startswith("validate_"):
                responsibilities.append(f"資料驗證: {func_info.name}")
        
        return responsibilities
