## 使用指南

### 分析觸發條件
```python
# ✅ 分析觸發邏輯
def should_run_context_analysis(project_state: ProjectState) -> bool:
    """判斷是否應該執行上下文分析"""
    
    triggers = [
        project_state.has_new_major_feature,      # 新增主要功能
        project_state.architecture_changed,       # 架構變更
        project_state.new_team_member_joined,     # 新團隊成員加入
        project_state.documentation_outdated,     # 文檔過時
        project_state.complexity_threshold_reached # 複雜度達到閾值
    ]
    
    return any(triggers)

def get_analysis_scope(trigger_reason: str) -> AnalysisScope:
    """根據觸發原因決定分析範圍"""
    
    scope_mapping = {
        "new_major_feature": AnalysisScope.INCREMENTAL,
        "architecture_changed": AnalysisScope.FULL,
        "new_team_member": AnalysisScope.FULL,
        "documentation_outdated": AnalysisScope.DOCUMENTATION_ONLY,
        "complexity_threshold": AnalysisScope.COMPLEXITY_FOCUSED
    }
    
    return scope_mapping.get(trigger_reason, AnalysisScope.FULL)
```

### 更新策略
```python
# ✅ 上下文更新策略
class ContextUpdateStrategy:
    """上下文更新策略"""
    
    def update_context_incrementally(self, 
                                   existing_context: Dict, 
                                   changes: List[ProjectChange]) -> Dict:
        """增量更新上下文"""
        updated_context = existing_context.copy()
        
        for change in changes:
            if change.type == "new_feature":
                self._add_feature_to_context(updated_context, change.feature)
            elif change.type == "modified_component":
                self._update_component_in_context(updated_context, change.component)
            elif change.type == "removed_feature":
                self._remove_feature_from_context(updated_context, change.feature)
        
        # 更新時間戳和版本
        updated_context["metadata"]["last_updated"] = datetime.now().isoformat()
        updated_context["metadata"]["version"] = self._increment_version(
            existing_context["metadata"]["version"]
        )
        
        return updated_context
```

