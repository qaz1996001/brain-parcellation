# 專案上下文分析規則

## 核心原則
- **系統化分析**: 按階段進行完整的專案結構分析
- **關係映射**: 清楚記錄組件之間的依賴關係和互動
- **文檔驅動**: 生成結構化的上下文文檔以提升專案理解
- **可維護性優先**: 專注於長期維護和開發者體驗

## 分析階段

### 1. 初始專案掃描

#### 目錄結構映射
```python
# ✅ 專案結構分析器
from pathlib import Path
from typing import Dict, List, Set
import ast

class ProjectStructureAnalyzer:
    """專案結構分析器"""
    
    def map_directory_structure(self, project_root: Path) -> DirectoryMap:
        """映射完整的目錄結構"""
        structure = DirectoryMap()
        
        for path in project_root.rglob("*"):
            if self._should_ignore(path):
                continue
                
            structure.add_path(
                path=path,
                file_type=self._classify_file_type(path),
                purpose=self._infer_file_purpose(path),
                size=path.stat().st_size if path.is_file() else 0
            )
        
        return structure
    
    def identify_architectural_patterns(self, structure: DirectoryMap) -> List[ArchitecturalPattern]:
        """識別架構模式"""
        patterns = []
        
        # 檢測 FastAPI 模式
        if self._has_fastapi_structure(structure):
            patterns.append(ArchitecturalPattern(
                name="FastAPI_MVC",
                components=["routers", "models", "schemas", "crud"],
                description="FastAPI MVC 架構模式"
            ))
        
        # 檢測醫學影像處理模式
        if self._has_medical_imaging_structure(structure):
            patterns.append(ArchitecturalPattern(
                name="Medical_Pipeline",
                components=["dicom2nii", "pipeline", "utils"],
                description="醫學影像處理管線架構"
            ))
        
        return patterns
```

#### 檔案類型和用途識別
```python
# ✅ 檔案分類器
class FileClassifier:
    """檔案分類器"""
    
    FILE_TYPE_PATTERNS = {
        "model": ["models/", "_model.py", "model.py"],
        "schema": ["schemas/", "_schema.py", "schema.py"], 
        "router": ["routers/", "_router.py", "router.py", "_routes.py"],
        "crud": ["crud/", "_crud.py"],
        "service": ["services/", "_service.py"],
        "utility": ["utils/", "_utils.py", "util.py"],
        "config": ["config", ".env", "settings"],
        "pipeline": ["pipeline/", "_pipeline.py"],
        "converter": ["convert/", "_convert.py", "dicom2nii/"],
        "test": ["test", "_test.py", "test_"],
    }
    
    def classify_file_type(self, file_path: Path) -> FileType:
        """分類檔案類型"""
        path_str = str(file_path).lower()
        
        for file_type, patterns in self.FILE_TYPE_PATTERNS.items():
            if any(pattern in path_str for pattern in patterns):
                return FileType(
                    category=file_type,
                    confidence=self._calculate_confidence(path_str, patterns),
                    purpose=self._infer_specific_purpose(file_path, file_type)
                )
        
        return FileType(category="unknown", confidence=0.0)
    
    def infer_file_purpose(self, file_path: Path) -> str:
        """推斷檔案用途"""
        if file_path.suffix == ".py":
            return self._analyze_python_file_purpose(file_path)
        elif file_path.suffix == ".toml":
            return self._analyze_config_file_purpose(file_path)
        elif file_path.suffix in [".md", ".rst"]:
            return "documentation"
        else:
            return "data_or_resource"
```

### 2. 程式碼分析

#### Python 檔案分析
```python
# ✅ Python 程式碼分析器
class PythonCodeAnalyzer:
    """Python 程式碼分析器"""
    
    def analyze_python_file(self, file_path: Path) -> PythonFileAnalysis:
        """分析 Python 檔案"""
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        tree = ast.parse(content)
        
        analysis = PythonFileAnalysis()
        analysis.imports = self._extract_imports(tree)
        analysis.classes = self._extract_classes(tree)
        analysis.functions = self._extract_functions(tree)
        analysis.constants = self._extract_constants(tree)
        analysis.dependencies = self._analyze_dependencies(tree)
        analysis.api_endpoints = self._extract_api_endpoints(tree)
        analysis.error_handling = self._analyze_error_handling(tree)
        
        return analysis
    
    def extract_component_responsibilities(self, analysis: PythonFileAnalysis) -> List[str]:
        """提取組件職責"""
        responsibilities = []
        
        # 從類別名稱推斷職責
        for class_info in analysis.classes:
            if "Service" in class_info.name:
                responsibilities.append(f"業務邏輯服務: {class_info.name}")
            elif "Model" in class_info.name:
                responsibilities.append(f"資料模型: {class_info.name}")
            elif "Router" in class_info.name:
                responsibilities.append(f"API 路由: {class_info.name}")
        
        # 從函數名稱推斷職責
        for func_info in analysis.functions:
            if func_info.name.startswith("process_"):
                responsibilities.append(f"資料處理: {func_info.name}")
            elif func_info.name.startswith("validate_"):
                responsibilities.append(f"資料驗證: {func_info.name}")
        
        return responsibilities
```

#### 狀態管理模式分析
```python
# ✅ 狀態管理分析器
class StateManagementAnalyzer:
    """狀態管理分析器"""
    
    def analyze_state_patterns(self, project_files: List[PythonFileAnalysis]) -> StateManagementReport:
        """分析狀態管理模式"""
        report = StateManagementReport()
        
        # 檢測資料庫狀態管理
        db_patterns = self._detect_database_patterns(project_files)
        report.database_patterns = db_patterns
        
        # 檢測快取狀態管理
        cache_patterns = self._detect_cache_patterns(project_files)
        report.cache_patterns = cache_patterns
        
        # 檢測會話狀態管理
        session_patterns = self._detect_session_patterns(project_files)
        report.session_patterns = session_patterns
        
        return report
    
    def map_data_flow(self, project_files: List[PythonFileAnalysis]) -> DataFlowMap:
        """映射資料流"""
        flow_map = DataFlowMap()
        
        for file_analysis in project_files:
            # 分析函數間的資料流
            for func in file_analysis.functions:
                data_sources = self._identify_data_sources(func)
                data_sinks = self._identify_data_sinks(func)
                
                flow_map.add_flow(
                    source=data_sources,
                    sink=data_sinks,
                    transformation=func.name,
                    file_location=file_analysis.file_path
                )
        
        return flow_map
