# ✅ 組件文檔生成器
class ComponentDocumentationGenerator:
    """組件文檔生成器"""
    
    def document_component(self, component: Component) -> ComponentDocumentation:
        """文檔化組件"""
        doc = ComponentDocumentation()
        
        # 主要職責
        doc.main_responsibility = self._extract_main_responsibility(component)
        
        # Props 和參數
        doc.props = self._document_props(component)
        
        # 狀態管理方法
        doc.state_management = self._document_state_management(component)
        
        # 子組件
        doc.child_components = self._identify_child_components(component)
        
        # 事件處理器
        doc.event_handlers = self._document_event_handlers(component)
        
        # 關鍵函數
        doc.key_functions = self._document_key_functions(component)
        
        # 錯誤處理
        doc.error_handling = self._document_error_handling(component)
        
        # 效能考量
        doc.performance_considerations = self._document_performance_aspects(component)
        
        # 自然語言說明
        doc.natural_language_description = self._generate_natural_description(component)
        
        return doc
    
    def generate_natural_description(self, component: Component) -> str:
        """生成自然語言描述"""
        description_parts = []
        
        # 基本描述
        if component.type == "router":
            description_parts.append(f"這是一個 API 路由組件，負責處理 {component.domain} 相關的 HTTP 請求")
        elif component.type == "service":
            description_parts.append(f"這是一個業務邏輯服務，提供 {component.domain} 的核心功能")
        elif component.type == "model":
            description_parts.append(f"這是一個資料模型，定義了 {component.domain} 的資料結構")
        
        # 主要功能
        if component.main_functions:
            functions_desc = ", ".join(component.main_functions[:3])
            description_parts.append(f"主要提供：{functions_desc}")
        
        # 依賴關係
        if component.dependencies:
            deps_desc = ", ".join(component.dependencies[:2])
            description_parts.append(f"依賴於：{deps_desc}")
        
        return "。".join(description_parts) + "。"
```

