# ✅ 基礎設施分析器
class InfrastructureAnalyzer:
    """基礎設施分析器"""
    
    def analyze_build_configuration(self, project_root: Path) -> BuildConfiguration:
        """分析建構配置"""
        config = BuildConfiguration()
        
        # 分析 pyproject.toml
        pyproject_path = project_root / "pyproject.toml"
        if pyproject_path.exists():
            config.python_config = self._analyze_pyproject_toml(pyproject_path)
        
        # 分析 Docker 配置
        docker_files = list(project_root.glob("*docker*"))
        if docker_files:
            config.docker_config = self._analyze_docker_config(docker_files)
        
        # 分析 CI/CD 配置
        cicd_configs = self._find_cicd_configs(project_root)
        if cicd_configs:
            config.cicd_config = self._analyze_cicd_configs(cicd_configs)
        
        return config
    
    def analyze_api_integration(self, project_analysis: ProjectAnalysis) -> APIIntegrationReport:
        """分析 API 整合"""
        report = APIIntegrationReport()
        
        # 內部 API 端點
        report.internal_endpoints = self._catalog_internal_endpoints(project_analysis)
        
        # 外部 API 整合
        report.external_integrations = self._identify_external_apis(project_analysis)
        
        # 認證流程
        report.authentication_flow = self._analyze_auth_flow(project_analysis)
        
        # 資料持久化
        report.data_persistence = self._analyze_data_persistence(project_analysis)
        
        return report
