## 效能最佳化

### 大型專案處理
```python
# ✅ 大型專案最佳化
class LargeProjectOptimizer:
    """大型專案分析最佳化器"""
    
    def __init__(self):
        self.analysis_cache = {}
        self.file_hash_cache = {}
    
    async def analyze_large_project(self, project_root: Path) -> ProjectAnalysis:
        """最佳化的大型專案分析"""
        
        # 並行分析不同模組
        analysis_tasks = []
        
        for module_path in self._identify_major_modules(project_root):
            if self._should_reanalyze_module(module_path):
                task = asyncio.create_task(
                    self._analyze_module(module_path)
                )
                analysis_tasks.append(task)
        
        # 等待所有分析完成
        module_analyses = await asyncio.gather(*analysis_tasks)
        
        # 合併分析結果
        return self._merge_analyses(module_analyses)
    
    def _should_reanalyze_module(self, module_path: Path) -> bool:
        """檢查模組是否需要重新分析"""
        current_hash = self._calculate_module_hash(module_path)
        cached_hash = self.file_hash_cache.get(str(module_path))
        
        return current_hash != cached_hash
```

