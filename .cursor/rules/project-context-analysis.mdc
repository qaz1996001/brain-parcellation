            description_parts.append(f"這是一個 API 路由組件，負責處理 {component.domain} 相關的 HTTP 請求")
        elif component.type == "service":
            description_parts.append(f"這是一個業務邏輯服務，提供 {component.domain} 的核心功能")
        elif component.type == "model":
            description_parts.append(f"這是一個資料模型，定義了 {component.domain} 的資料結構")
        
        # 主要功能
        if component.main_functions:
            functions_desc = ", ".join(component.main_functions[:3])
            description_parts.append(f"主要提供：{functions_desc}")
        
        # 依賴關係
        if component.dependencies:
            deps_desc = ", ".join(component.dependencies[:2])
            description_parts.append(f"依賴於：{deps_desc}")
        
        return "。".join(description_parts) + "。"
