        "new_major_feature": AnalysisScope.INCREMENTAL,
        "architecture_changed": AnalysisScope.FULL,
        "new_team_member": AnalysisScope.FULL,
        "documentation_outdated": AnalysisScope.DOCUMENTATION_ONLY,
        "complexity_threshold": AnalysisScope.COMPLEXITY_FOCUSED
    }
    
    return scope_mapping.get(trigger_reason, AnalysisScope.FULL)
